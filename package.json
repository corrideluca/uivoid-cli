{
  "name": "uivoid",
  "version": "0.2.2",
  "description": "Create UIvoid MCP projects from existing APIs",
  "homepage": "https://www.uivoid.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corrideluca/uivoid-cli.git"
  },
  "bugs": {
    "url": "https://github.com/corrideluca/uivoid-cli/issues"
  },
  "type": "module",
  "bin": {
    "uivoid": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsx src/cli.ts",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "cli",
    "api",
    "backoffice",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.8.6",
    "commander": "^14.0.1",
    "open": "^10.2.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
